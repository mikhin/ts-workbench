{
  "jsPlugins": ["../index.cjs"],
  "categories": { "correctness": "off" },
  "rules": {
    "local/no-comments": "error",
    "local/one-function-export": "error",
    "local/no-branching-exports": "error",
    "local/no-classes": "error"
  },
  "overrides": [
    {
      "files": ["components/**/*.ts"],
      "rules": { "local/no-ts-in-components": "error" }
    }
  ]
}
