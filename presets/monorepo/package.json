{
  "scripts": {
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "pnpm lint:oxlint && pnpm lint:types",
    "lint:oxlint": "oxlint --deny-warnings --no-error-on-unmatched-pattern --ignore-pattern 'scripts/lint-plugin/fixtures/**'",
    "lint:fix": "pnpm lint:oxlint --fix && pnpm lint:types",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r --parallel run test",
    "mutation": "pnpm -r run mutation",
    "deadcode": "knip",
    "dead-files": "pnpm -r run dead-files",
    "dead-mocks": "pnpm -r run dead-mocks",
    "dup": "jscpd",
    "build": "pnpm -r run build",
    "storybook:build": "pnpm -r --if-present run storybook:build",
    "react-doctor": "pnpm -r --if-present run react-doctor",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm deadcode && pnpm dead-files && pnpm dead-mocks && pnpm dup && pnpm build"
  }
}
