{
  "name": "ts-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings && pnpm lint:types",
    "lint:types": "oxlint --type-aware -c .oxlintrc.type-aware.json --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint -c .oxlintrc.json --deny-warnings --fix && pnpm lint:types",
    "typecheck": "tsc",
    "test": "vitest run --coverage --passWithNoTests",
    "mutation": "stryker run",
    "mutation:changed": "stryker run --mutate \"$(node scripts/changed-mutants.mjs)\"",
    "deadcode": "knip",
    "dead-files": "node scripts/find-dead-code.mjs",
    "dead-mocks": "node scripts/find-dead-mocks.mjs",
    "dup": "jscpd",
    "dup:top": "jscpd -r json -o reports/jscpd -t 100 -s && node scripts/jscpd-top.mjs",
    "strip-comments": "node scripts/strip-comments.mjs",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm test:tooling && pnpm deadcode && pnpm dead-files && pnpm dead-mocks && pnpm dup && pnpm run --if-present build",
    "prepare": "simple-git-hooks",
    "preset": "node scripts/preset.mjs",
    "test:tooling": "node --test scripts/*.test.mjs scripts/lint-plugin/*.test.mjs",
    "dup:types": "node scripts/find-duplicate-types.mjs",
    "dead-methods": "node scripts/find-dead-service-methods.mjs",
    "service-map": "node scripts/service-map.mjs",
    "drift": "node scripts/architecture-drift.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "nano-staged": "^1.0.2",
    "oxc-parser": "^0.156.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "fast-check": "^4.10.2",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "simple-git-hooks"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  }
}
